# Copy to .env and adjust values
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
REDIS_URL=redis://127.0.0.1:6379/1

# Google OAuth Credentials (for Sign in with Google)
# Generate these at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database: sqlite (default) or postgresql
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://user:password@localhost:5432/faq_platform

# Email (password reset)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@faqplatform.local

# Gemini — AI FAQ assistant (optional; keyword fallback if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Reputation point values (optional overrides)
POINTS_ANSWER_POSTED=5
POINTS_UPVOTE_RECEIVED=10
POINTS_ACCEPTED_ANSWER=20
POINTS_FAQ_CONTRIBUTION=15
POINTS_EDIT_ACCEPTED=10
